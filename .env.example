# Copy to .env (which is git-ignored). Secrets live here or in the real environment, never in influxkit.toml.
INFLUXKIT_TOKEN=replace-me
# or read it from a mounted secret file:
# INFLUXKIT_TOKEN_FILE=/run/secrets/influx-token

# Which config file and table to use (default: ./influxkit.toml, the whole file):
# INFLUXKIT_CONFIG=config/influxkit.toml
# INFLUXKIT_SECTION=prod

# Optional overrides of any setting (nested keys use "__"):
# INFLUXKIT_CONNECTION__URL=https://influx.internal:8181
# INFLUXKIT_CONNECTION__PROXY=http://user:password@proxy.internal:3128
# INFLUXKIT_WRITE__CONCURRENCY=32
