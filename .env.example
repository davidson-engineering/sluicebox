# Copy to .env (which is git-ignored). Secrets live here or in the real environment, never in sluicebox.toml.
SLUICEBOX_TOKEN=replace-me
# or read it from a mounted secret file:
# SLUICEBOX_TOKEN_FILE=/run/secrets/influx-token

# Which config file and table to use (default: ./sluicebox.toml, the whole file):
# SLUICEBOX_CONFIG=config/sluicebox.toml
# SLUICEBOX_SECTION=prod

# Optional overrides of any setting (nested keys use "__"):
# SLUICEBOX_CONNECTION__URL=https://influx.internal:8181
# SLUICEBOX_CONNECTION__PROXY=http://user:password@proxy.internal:3128
# SLUICEBOX_WRITE__CONCURRENCY=32
